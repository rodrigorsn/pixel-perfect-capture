{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(bun:*)", "Bash(bunx:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git switch:*)", "Bash(git checkout -b:*)",
      "Bash(git add:*)", "Bash(git commit -m:*)", "Bash(git fetch:*)", "Bash(git worktree:*)",
      "Bash(git push origin maestri/:*)", "Bash(git push origin etapa/:*)",
      "Bash(gh pr:*)", "Bash(ls:*)", "WebFetch", "WebSearch"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push origin main:*)",
      "Bash(git push * --force*)", "Bash(git push * -f)", "Bash(git push * -f *)",
      "Bash(git push * main)", "Bash(git push * main *)", "Bash(git push * HEAD:main*)",
      "Bash(git reset --hard:*)", "Bash(git rebase:*)", "Bash(git commit --amend:*)",
      "Bash(rm -rf:*)", "Read(./.env*)"
    ]
  }
}
